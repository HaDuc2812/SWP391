    </servlet>
    <servlet>
        <servlet-name>OrderDetailControll</servlet-name>
        <servlet-class>controller.OrderDetailControll</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ApproveOrders</servlet-name>
        <servlet-class>controller.ApproveOrders</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ListAllGoods</servlet-name>
        <url-pattern>/list</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StorageOrderToSupplier</servlet-name>
        <url-pattern>/orderToSupplier</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ShopOrders</servlet-name>
        <url-pattern>/shoporders</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DataPush</servlet-name>
        <url-pattern>/datapush</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoadFurniture</servlet-name>
        <url-pattern>/loadFurniture</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ListOrdersFromShops</servlet-name>
        <url-pattern>/listfromshops</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>OrderDetailControll</servlet-name>
        <url-pattern>/orderDetail</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ApproveOrders</servlet-name>
        <url-pattern>/approveorders</url-pattern>
    </servlet-mapping>
    <welcome-file-list>
        <welcome-file>Homepage.jsp</welcome-file>
    </welcome-file-list>
    <servlet>
        <servlet-name>ForgotPassword</servlet-name>
        <servlet-class>controller.ForgotPassword</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>UpdateUser</servlet-name>
        <servlet-class>controller.UpdateUser</servlet-class>
    </servlet>
    <servlet>
